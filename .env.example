# Funnel McQueen CRM environment variables.
#
# Copy to .env.local for local development. On Vercel, set the same names in
# Project Settings > Environment Variables. Contract: docs/ARCHITECTURE.md section 3.
#
# Rules:
#   - Never prefix a secret with NEXT_PUBLIC_. Those values are inlined into the browser bundle.
#     `npm run check:bundle` fails the build if a service-role key or Twilio secret leaks.
#   - Only src/server/env.ts reads these (it has `import 'server-only'`), and it validates them
#     with Zod. src/instrumentation.ts runs that validation in Next's startup hook and exits the
#     process when it fails, so an invalid combination never serves a request instead of degrading
#     silently (DEVIATIONS D35). `next build` does not run the hook, so builds are unaffected.
#   - The values below are either placeholders or the *public* Supabase local demo keys.
#     There are no real secrets in this file, and none may ever be committed.
#
# Legend: [required] always needed · [required with twilio] needed when DIALER_DRIVER=twilio
#         [optional] safe to leave unset

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# [required] Supabase API origin.
#   localbase (no Docker): `npm run localbase` prints it, default http://127.0.0.1:54321.
#   supabase start:        http://127.0.0.1:54321
#   Hosted:                Project Settings > API > Project URL (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# [required] anon (legacy JWT) or publishable key. This one *is* meant for the browser:
# RLS decides what each signed-in user can read, so exposing it is by design.
# Hosted: Project Settings > API > anon/publishable key.
# The default below is the well-known Supabase local demo anon key, which is what both
# `npm run localbase` and `supabase start` issue. It only works against a local stack.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# [required] service_role (legacy JWT) or secret key. SERVER-ONLY: it bypasses RLS entirely.
# Used only for Supabase Auth admin operations (create/ban users, npm run make-admin,
# npm run db:seed), for Twilio webhooks (which have no user session), and for the voicemail
# route's recording-SID lookup (docs/DEVIATIONS.md D13). Never anywhere else.
# Hosted: Project Settings > API > service_role/secret key. Rotate it if it ever leaves the server.
# The default below is the local demo service_role key (local stacks only).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# [required with twilio, recommended always] The exact public origin of this deployment:
# scheme + host (+ port), no path, no trailing slash. Validation rejects anything else.
#
# Twilio webhook signatures are computed over APP_BASE_URL + path, so this must match the URL
# Twilio actually calls, character for character. Vercel's proxy rewrites the Host header, so
# the value cannot be derived from the request.
#   local, no webhooks:  http://localhost:3000
#   local, via a tunnel: https://<subdomain>.ngrok-free.app (or the cloudflared URL)
#   production:          https://crm.example.com
APP_BASE_URL=http://localhost:3000

# [optional] Which driver the CALL button uses: twilio | tel | mock. SERVER-ONLY; the resolved
# value reaches the browser only as a prop from the (app) layout.
#   twilio  in-app calling through Twilio Voice (needs every TWILIO_* variable and APP_BASE_URL)
#   tel     hand off to the device dialer with a tel: link; outcomes are logged manually
#   mock    simulated ringing/connect/hangup and a generated voicemail tone, for dev and tests
#
# Unset resolves automatically: `twilio` when Twilio is fully configured, otherwise `mock` in
# development/test and `tel` in production (a production app must never silently fake calls).
# DIALER_DRIVER=mock together with NODE_ENV=production is refused as an invalid environment and the
# server refuses to start (docs/DEVIATIONS.md D24, enforced at startup since D35). Voicemail audio is
# never synthesized in production either: an unconfigured production deployment answers 503 (D33).
DIALER_DRIVER=

# [optional] Which calendar meeting booking uses: google | mock. SERVER-ONLY.
#   mock    an in-memory closer calendar (weekdays 10-12 and 14-17) for development and tests
#   google  the connected Google Calendar (second milestone; unavailable until then)
# Unset resolves to mock in development/test and to "booking unavailable" in production.
# CALENDAR_DRIVER=mock with NODE_ENV=production is refused at startup (docs/DEVIATIONS.md D46).
CALENDAR_DRIVER=

# ---------------------------------------------------------------------------
# Twilio Programmable Voice (SERVER-ONLY)
# All five are [required with twilio] and unused otherwise. README section "Twilio setup"
# walks through producing them in order.
# ---------------------------------------------------------------------------

# Console > Account info (starts with AC). Webhooks reject any request whose AccountSid
# does not match this value.
TWILIO_ACCOUNT_SID=

# Console > Account info > Auth token. Used to validate the X-Twilio-Signature header on every
# /api/twilio/* request. This is the highest-value secret here: anyone holding it can forge
# webhooks. It is never used to place calls; the API key below is.
TWILIO_AUTH_TOKEN=

# Console > Settings > Account settings > API keys & auth tokens > Create API key (Standard).
# The SID starts with SK. Used to mint browser Voice access tokens and to fetch voicemail media.
TWILIO_API_KEY_SID=

# The secret shown once when the API key is created. If it is lost, create a new key and delete
# the old one; it cannot be retrieved later.
TWILIO_API_KEY_SECRET=

# Console > Voice > Manage > TwiML Apps (SID starts with AP). Its Voice Request URL must be
# {APP_BASE_URL}/api/twilio/voice/outbound (HTTP POST) and its Status Callback URL
# {APP_BASE_URL}/api/twilio/voice/status. Every purchased number points its voice handler at
# this app, which is what the CRM sets for you when an admin adds the number.
TWILIO_TWIML_APP_SID=

# ---------------------------------------------------------------------------
# Test and tooling overrides — all [optional], none belong in a deployment
# ---------------------------------------------------------------------------

# Point the integration suite at a real Supabase stack (e.g. `supabase start`) instead of the
# in-memory localbase the test globalSetup starts. All three must be set together, and the
# target database must already be migrated and seeded (`npm run db:seed`).
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
# Optional: enables tests that mint their own JWTs (`supabase status` prints the JWT secret).
# SUPABASE_TEST_JWT_SECRET=

# `npm run db:seed` creates accounts with a published password, including an ADMIN, so it
# refuses any host other than localhost/127.0.0.1. Set to 1 only for a throwaway dev project.
# SEED_ALLOW_REMOTE=1

# Ports used by the dev and e2e helpers.
# LOCALBASE_PORT=54321   # npm run dev:local
# E2E_APP_PORT=3170      # npx playwright test
# E2E_LOCALBASE_PORT=54370
