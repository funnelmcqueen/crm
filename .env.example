# Funnel McQueen CRM environment variables.
# Copy to .env.local for local development. On Vercel, set the same names in Project Settings.
# Never prefix a secret with NEXT_PUBLIC_: those values are inlined into the browser bundle.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Local (no Docker): run `npm run localbase`. It serves http://127.0.0.1:54321 and prints the anon and
# service_role keys to paste below. They are the well-known Supabase local demo keys, signed with the
# demo JWT secret, so they only work against localbase or `supabase start`.
# Hosted Supabase: Project Settings > API (URL, anon/publishable key, service_role/secret key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# anon (legacy JWT) or publishable key. Safe in the browser: RLS decides what each user can read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role (legacy JWT) or secret key. SERVER-ONLY, bypasses RLS. Used only for Supabase Auth admin
# operations (create/disable users, npm run make-admin) and Twilio webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Exact public origin, no path and no trailing slash. Twilio webhook signatures are checked against
# APP_BASE_URL + path, so behind a tunnel (ngrok, cloudflared) use the tunnel URL, e.g.
# https://abc123.ngrok-free.app, and point the TwiML App at it. Required when DIALER_DRIVER=twilio.
APP_BASE_URL=http://localhost:3000

# Dialer used by the CALL button: twilio | tel | mock. SERVER-ONLY (passed to the client as a prop).
#   twilio  in-app calls through Twilio Voice (needs every TWILIO_* variable and APP_BASE_URL)
#   tel     native phone dialer via tel: links
#   mock    simulated ringing/connect/hangup for local development and tests
# Leave empty to pick automatically: twilio when Twilio is fully configured, otherwise mock
# (or tel when NODE_ENV=production).
DIALER_DRIVER=

# ---------------------------------------------------------------------------
# Twilio Programmable Voice (SERVER-ONLY; all required when DIALER_DRIVER=twilio)
# ---------------------------------------------------------------------------
# Console > Account info
TWILIO_ACCOUNT_SID=
# Console > Account info. Also used to validate X-Twilio-Signature on every webhook.
TWILIO_AUTH_TOKEN=
# Console > Account > API keys & tokens > Create API key (Standard)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Voice > TwiML Apps. Voice URL: {APP_BASE_URL}/api/twilio/voice/outbound (HTTP POST)
TWILIO_TWIML_APP_SID=
